<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Minimal Header: Battery % + Range (tapping opens app) -->
    <LinearLayout
        android:id="@+id/widgetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tvWidgetSoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="@color/widget_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:text="-- km"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Big Lock & Unlock Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWidgetLock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_primary"
            android:padding="4dp"
            android:text="Lock"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetUnlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_tertiary"
            android:padding="4dp"
            android:text="Unlock"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_tertiary_container"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Big Full-Width Sync Button -->
    <Button
        android:id="@+id/btnWidgetRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="0.8"
        android:background="@drawable/bg_widget_btn_secondary"
        android:padding="4dp"
        android:text="Sync"
        android:textAllCaps="false"
        android:textColor="@color/widget_on_secondary_container"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

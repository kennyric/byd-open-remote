<?xml version="1.0" encoding="utf-8"?>
<!-- Compact 68dp Action Row: keeps touch targets comfortable without squeezing the battery card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tileWidgetLock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_btn_primary"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/ivWidgetLock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_slot_lock"
            android:tint="@color/widget_on_primary_container" />

        <Button
            android:id="@+id/btnWidgetLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Lock"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tileWidgetUnlock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_btn_tertiary"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/ivWidgetUnlock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_slot_unlock"
            android:tint="@color/widget_on_tertiary_container" />

        <Button
            android:id="@+id/btnWidgetUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Unlock"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_tertiary_container"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tileWidgetAc"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_btn_secondary"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/ivWidgetAc"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_slot_ac"
            android:tint="@color/widget_on_secondary_container" />

        <Button
            android:id="@+id/btnWidgetAc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="AC On"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_secondary_container"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tileWidgetRefresh"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_btn_tonal"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/ivWidgetRefresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_slot_sync"
            android:tint="@color/widget_on_surface_variant" />

        <Button
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Sync"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

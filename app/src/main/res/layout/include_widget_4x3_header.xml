<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3 Top Micro Bar: Option A Icon + Preferred Car Model left, Status Pills right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivWidgetBrandLogo"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_ev_watch_logo"
            android:tint="@color/accent_emerald" />

        <TextView
            android:id="@+id/tvWidgetCarModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWidgetBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_widget_chip"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:text="Ready"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvWidgetLockStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_widget_chip"
        android:maxLines="1"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:text="Locked"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvWidgetAcStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_widget_chip"
        android:maxLines="1"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:text="AC Off"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>

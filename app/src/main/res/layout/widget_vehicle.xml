<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Wide 4x2 - 5x2 Header: Battery, Range, AC Status -->
    <LinearLayout
        android:id="@+id/widgetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetSoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="@color/widget_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="-- km"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetAcStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="AC Off"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Permanent Middle Status Row: Action/Syncing state + Last Sync Time (prevents button height jump) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ready"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvWidgetLastSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Last sync --:--"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Permanently Compact Action Row: Lock, Unlock, AC (merged toggle), Sync -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWidgetLock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_primary"
            android:padding="4dp"
            android:text="Lock"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetUnlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_tertiary"
            android:padding="4dp"
            android:text="Unlock"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_tertiary_container"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetAc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_secondary"
            android:padding="4dp"
            android:text="AC"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_secondary_container"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_tonal"
            android:padding="4dp"
            android:text="Sync"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shown automatically when resized to 3+ rows: Location bar with street name & tap-to-navigate -->
    <LinearLayout
        android:id="@+id/layoutWidgetLocationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/label_car_location"
            android:src="@drawable/ic_byd_location" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetLocationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Car Location · Navigate"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetLocationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/location_widget_empty"
                android:textColor="@color/widget_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

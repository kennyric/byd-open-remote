<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- 4x2 Top Micro Bar: Brand Icon + Preferred Car Model left, Status Pills right (4x3 Twin) -->
    <LinearLayout
        android:id="@+id/widgetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivWidgetBrandLogo"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_ev_watch_logo"
                android:tint="@color/accent_emerald" />

            <TextView
                android:id="@+id/tvWidgetCarModel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWidgetBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_chip"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2.5dp"
            android:text="Ready"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWidgetLockStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_chip"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2.5dp"
            android:text="Locked"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWidgetAcStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_widget_chip"
            android:maxLines="1"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2.5dp"
            android:text="AC Off"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Elevated Unified Battery Subcard matching App & 4x3 -->
    <LinearLayout
        android:id="@+id/layoutWidgetBatteryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_subcard"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWidgetSoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--%"
                android:textColor="@color/widget_on_surface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="-- km"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbWidgetSoc"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_widget_soc_on_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWidgetBatteryMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWidgetLastSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Last sync --:--"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden placeholder kept for size-transition view checks; 4x3 layout provides the Location Bar -->
    <FrameLayout
        android:id="@+id/layoutWidgetLocationBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Compact 4-Tile Action Row matching 4x3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tileWidgetLock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnWidgetLock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawablePadding="2dp"
                android:drawableTop="@drawable/ic_widget_lock_sm"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="Lock"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileWidgetUnlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_tertiary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnWidgetUnlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawablePadding="2dp"
                android:drawableTop="@drawable/ic_widget_unlock_sm"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="Unlock"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_tertiary_container"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileWidgetAc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_secondary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnWidgetAc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawablePadding="2dp"
                android:drawableTop="@drawable/ic_widget_ac_sm"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="AC On"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_secondary_container"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileWidgetRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_tonal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnWidgetRefresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawablePadding="2dp"
                android:drawableTop="@drawable/ic_widget_sync_sm"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="Sync"
                android:textAllCaps="false"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

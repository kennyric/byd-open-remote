<?xml version="1.0" encoding="utf-8"?>
<!-- Rename dialog body: one text field, prefilled with this car's override (if any). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.BydWatch.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/garage_rename_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGarageRename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/garage_rename_help"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />
</LinearLayout>

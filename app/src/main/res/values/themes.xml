<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BydWatch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="colorPrimaryDark">@color/bg_obsidian</item>
        <item name="android:colorPrimaryDark">@color/bg_obsidian</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/widget_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/widget_on_primary_container</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryContainer">@color/widget_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/widget_on_secondary_container</item>
        <item name="colorTertiaryContainer">@color/widget_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/widget_on_tertiary_container</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@color/bg_obsidian</item>
        <item name="android:navigationBarColor">@color/bg_obsidian</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="textInputStyle">@style/Widget.BydWatch.TextInputLayout</item>
    </style>

    <style name="Widget.BydWatch.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.BydWatch.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Theme.BydWatch.TranslucentDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
